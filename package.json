{
  "name": "lifeprep-academy-optimization",
  "version": "1.0.0",
  "description": "Image optimization tools for Lifeprep Academy Foundation website",
  "main": "optimize-images.js",
  "scripts": {
    "optimize": "node optimize-images.js",
    "serve": "http-server -p 3000",
    "build": "node build-assets.js && node cache-bust.js",
    "build:prod": "node build-assets.js && node cache-bust.js && node minify-html.js",
    "format:html": "node format-html.js",
    "deploy:mlsregistration": "wrangler deploy --config wrangler.jsonc",
    "preview:mlsregistration": "wrangler dev --config wrangler.jsonc"
  },
  "devDependencies": {
    "sharp": "^0.32.6",
    "http-server": "^14.1.1",
    "csso": "^5.0.5",
    "terser": "^5.31.0",
    "prettier": "^3.6.2"
  },
  "keywords": ["image-optimization", "performance", "web"],
  "author": "Lifeprep Academy Foundation",
  "license": "MIT"
}
